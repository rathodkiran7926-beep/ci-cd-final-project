{
  "name": "coursera-cicd-final-project",
  "version": "1.0.0",
  "private": true,
  "description": "CI/CD final project using GitHub Actions, Tekton, and OpenShift",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "jest --runInBand --coverage"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "eslint": "^9.39.1",
    "jest": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/app.js"],
    "coverageThreshold": {
      "global": { "branches": 100, "functions": 100, "lines": 100, "statements": 100 }
    }
  }
}
